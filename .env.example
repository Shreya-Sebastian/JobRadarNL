# Copy to .env and adjust. All settings are prefixed RADAR_.
RADAR_DATABASE_URL=sqlite:///./radar.db
# RADAR_DATABASE_URL=postgresql+psycopg://radar:radar@localhost:5432/radar
RADAR_EXTRACTOR=rules            # rules | llm
RADAR_LLM_MODEL=gpt-4o-mini
RADAR_LLM_MAX_POSTINGS_PER_RUN=200
RADAR_MAX_WORKERS=8
RADAR_PER_DOMAIN_DELAY=0.5
# OPENAI_API_KEY=...             # only needed for RADAR_EXTRACTOR=llm and `radar eval --extractor llm`
# RADAR_ADZUNA_APP_ID=...       # only for `radar recall` (free key at https://developer.adzuna.com)
# RADAR_ADZUNA_APP_KEY=...
# RADAR_ADMIN_TOKEN=...          # enables the admin "crawl now" page at /#admin; generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
